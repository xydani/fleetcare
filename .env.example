# Copy to .env to override the defaults used by docker-compose.yml
POSTGRES_USER=fleetcare
POSTGRES_PASSWORD=fleetcare
POSTGRES_PORT=5432

MONGO_USER=fleetcare
MONGO_PASSWORD=fleetcare
MONGO_PORT=27017

# Port of the API gateway, the only service published on the host
GATEWAY_PORT=8080
# "demo" loads sample data; leave empty for empty databases
SPRING_PROFILES_ACTIVE=demo
# Daily inspection check of the notification service ("-" disables it)
REMINDERS_CRON=0 0 7 * * *
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
